#!/usr/bin/env bash

# ---
# IMPORTANT: Use the following statement at the TOP OF EVERY TEST SCRIPT
#            to ensure that this package's 'bin/' subfolder is added to the path so that
#            this package's CLIs can be invoked by their mere filename in the rest
#            of the script.
# ---
PATH=${PWD%%/test*}/bin:$PATH

# Helper function for error reporting.
die() { (( $# > 0 )) && echo "ERROR: $*" >&2; exit 1; }

# Create a temp. dir.
tmpDir=$(mktemp -d -t XXXX) # Works on both macOS and Linux; note: dir. name will have random extension on OSX (e.g., '.../XXXX.bJViLcM3') and none on Linux (e.g., '.../vXDA')
trap 'rm -rf "$tmpDir"' EXIT # Set up exit trap to automatically clean up the temp dir.

# Copy fixtures to temp. dir.
cp -R ./.fixtures/* "$tmpDir/" || die

# Change to temp dir.
cd "$tmpDir" || die

mkdir -p fakebin || die
cat > fakebin/touch <<'EOF' || die
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$FILEICON_TOUCH_LOG"
exec /usr/bin/touch "$@"
EOF
chmod +x fakebin/touch || die

export FILEICON_TOUCH_LOG=$tmpDir/touch.log
PATH=$tmpDir/fakebin:$PATH

# A regular folder should not be touched.
: > "$FILEICON_TOUCH_LOG" || die
fileicon set folder img.png || die "Failed to set custom icon on regular folder."
[[ ! -s $FILEICON_TOUCH_LOG ]] || die "Unexpectedly touched regular folder."

# An application bundle should be touched after assigning a custom icon.
cp -R folder Sample.app || die
: > "$FILEICON_TOUCH_LOG" || die
fileicon set Sample.app img.png || die "Failed to set custom icon on application bundle."
grep -Fqx 'Sample.app' "$FILEICON_TOUCH_LOG" || die "Application bundle was not touched after setting a custom icon."

# An application bundle should be touched after removing a custom icon.
: > "$FILEICON_TOUCH_LOG" || die
fileicon rm Sample.app || die "Failed to remove custom icon from application bundle."
grep -Fqx 'Sample.app' "$FILEICON_TOUCH_LOG" || die "Application bundle was not touched after removing a custom icon."
